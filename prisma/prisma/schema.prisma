generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id        String   @id @default(uuid())
  requestId String?  @unique
  reason    String
  toothId   String?
  date      String
  time      String
  fullName  String
  phone     String
  email     String?
  note      String?  @db.VarChar(500)
  consent   Boolean
  status    String   @default("received")
  createdAt DateTime @default(now())
}
